{
	"name": "kite-blog",
	"main": "./worker.ts",
	"compatibility_date": "2026-08-09",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "force-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/api/*"
		]
	}
}