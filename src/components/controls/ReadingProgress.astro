---
// 阅读进度条：渲染在文章详情页顶部，随滚动更新宽度。
// 组件放在 MainGridLayout（Swup 不替换的静态外壳）中，脚本只需绑定一次，
// 无需在 astro:page-load 后重新初始化。
---

<div id="reading-progress-bar" aria-hidden="true"></div>

<style>
	#reading-progress-bar {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 3px;
		z-index: 1000;
		pointer-events: none;
		transform: scaleX(0);
		transform-origin: 0 50%;
		background: linear-gradient(
			90deg,
			var(--primary),
			oklch(0.66 0.15 22)
		);
		opacity: 0;
		transition:
			opacity 0.3s ease,
			transform 0.1s linear;
	}
	#reading-progress-bar.visible {
		opacity: 1;
	}
</style>

<script is:inline data-swup-ignore-script>
	(function initReadingProgress() {
		var bar = document.getElementById("reading-progress-bar");
		if (!bar) return;

		var ticking = false;

		function update() {
			ticking = false;
			var max = document.documentElement.scrollHeight - window.innerHeight;
			var ratio = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
			bar.style.transform = "scaleX(" + ratio.toFixed(4) + ")";
			bar.classList.toggle("visible", ratio > 0.003);
		}

		function requestUpdate() {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(update);
		}

		window.addEventListener("scroll", requestUpdate, { passive: true });
		window.addEventListener("resize", requestUpdate, { passive: true });
		document.addEventListener("astro:page-load", requestUpdate);
		document.addEventListener("astro:after-swap", requestUpdate);
		update();
	})();
</script>