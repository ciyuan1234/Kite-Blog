---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "云端文章";
const description =
	"KiteBlog 通过 Cloudflare KV 动态发布的文章列表，适合从网页端快速更新内容。";
---

<MainGridLayout title={title} description={description}>
	<section class="live-shell">
		<header class="live-hero">
			<div>
				<p class="live-kicker">Cloudflare Posts</p>
				<h1>云端文章</h1>
				<p>这里展示从 KiteBlog Studio 发布到 Cloudflare KV 的内容。静态正式文章仍保留在归档页。</p>
			</div>
			<a href="/studio/" class="live-action">
				<Icon is:inline name="material-symbols:tune-rounded" />
				进入控制台
			</a>
		</header>

		<div class="live-layout">
			<aside class="live-list-panel">
				<div class="panel-heading">
					<Icon is:inline name="material-symbols:library-books-outline-rounded" />
					<div>
						<h2>文章列表</h2>
						<p data-live-count>正在连接云端...</p>
					</div>
				</div>
				<div class="live-list" data-live-list></div>
			</aside>

			<article class="live-reader" data-live-reader>
				<div class="empty-reader">
					<Icon is:inline name="material-symbols:cloud-outline-rounded" />
					<h2>选择一篇云端文章</h2>
					<p>如果 Cloudflare KV 尚未配置，部署后这里会显示连接提示。</p>
				</div>
			</article>
		</div>
	</section>

	<script is:inline>
		const listEl = document.querySelector("[data-live-list]");
		const countEl = document.querySelector("[data-live-count]");
		const readerEl = document.querySelector("[data-live-reader]");
		let posts = [];

		function escapeHtml(value) {
			return String(value || "").replace(/[&<>"']/g, (char) => ({
				"&": "&amp;",
				"<": "&lt;",
				">": "&gt;",
				'"': "&quot;",
				"'": "&#39;",
			})[char]);
		}

		function inlineMarkdown(value) {
			return escapeHtml(value)
				.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
				.replace(/`([^`]+)`/g, "<code>$1</code>")
				.replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, '<a href="$2" target="_blank" rel="noreferrer">$1</a>');
		}

		function markdownToHtml(markdown) {
			const content = String(markdown || "").replace(/^---\n[\s\S]*?\n---\n?/, "");
			const lines = content.split(/\r?\n/);
			const html = [];
			let inCode = false;
			let paragraph = [];
			let list = [];

			function flushParagraph() {
				if (!paragraph.length) return;
				html.push(`<p>${inlineMarkdown(paragraph.join(" "))}</p>`);
				paragraph = [];
			}

			function flushList() {
				if (!list.length) return;
				html.push(`<ul>${list.map((item) => `<li>${inlineMarkdown(item)}</li>`).join("")}</ul>`);
				list = [];
			}

			for (const line of lines) {
				if (line.trim().startsWith("```")) {
					flushParagraph();
					flushList();
					if (inCode) {
						html.push("</code></pre>");
						inCode = false;
					} else {
						html.push("<pre><code>");
						inCode = true;
					}
					continue;
				}
				if (inCode) {
					html.push(escapeHtml(line) + "\n");
					continue;
				}
				if (!line.trim()) {
					flushParagraph();
					flushList();
					continue;
				}
				const heading = line.match(/^(#{1,4})\s+(.+)$/);
				if (heading) {
					flushParagraph();
					flushList();
					const level = heading[1].length + 1;
					html.push(`<h${level}>${inlineMarkdown(heading[2])}</h${level}>`);
					continue;
				}
				const listItem = line.match(/^[-*]\s+(.+)$/);
				if (listItem) {
					flushParagraph();
					list.push(listItem[1]);
					continue;
				}
				paragraph.push(line.trim());
			}

			flushParagraph();
			flushList();
			if (inCode) html.push("</code></pre>");
			return html.join("");
		}

		function renderList() {
			if (!listEl) return;
			if (!posts.length) {
				listEl.innerHTML = '<p class="live-empty">还没有云端文章。可以在 /studio/ 发布一篇。</p>';
				if (countEl) countEl.textContent = "0 篇文章";
				return;
			}
			if (countEl) countEl.textContent = `${posts.length} 篇文章`;
			listEl.innerHTML = posts
				.map((post) => `<button type="button" class="live-list-item" data-slug="${escapeHtml(post.slug)}">
					<strong>${escapeHtml(post.title || post.slug)}</strong>
					<span>${escapeHtml(post.category || "文章")} · ${escapeHtml(post.publishedAt || "")}</span>
					<small>${escapeHtml(post.description || "暂无摘要")}</small>
				</button>`)
				.join("");
		}

		function renderPost(post) {
			if (!readerEl || !post) return;
			readerEl.innerHTML = `<header class="reader-head">
				${post.cover ? `<img src="${escapeHtml(post.cover)}" alt="" loading="lazy" />` : ""}
				<div>
					<span>${escapeHtml(post.category || "文章")}</span>
					<h2>${escapeHtml(post.title || post.slug)}</h2>
					<p>${escapeHtml(post.description || "")}</p>
					<div class="reader-meta">${escapeHtml(post.publishedAt || "")}${post.tags ? ` · ${escapeHtml(post.tags)}` : ""}</div>
				</div>
			</header>
			<div class="live-content">${markdownToHtml(post.markdown || "")}</div>`;
			document.querySelectorAll(".live-list-item").forEach((item) => {
				item.classList.toggle("active", item.getAttribute("data-slug") === post.slug);
			});
			if (location.hash.slice(1) !== post.slug) {
				history.replaceState(null, "", `#${post.slug}`);
			}
		}

		async function loadPost(slug) {
			if (!slug) return;
			readerEl.innerHTML = '<p class="live-loading">正在读取文章...</p>';
			try {
				const response = await fetch(`/api/kite-posts?slug=${encodeURIComponent(slug)}`, { cache: "no-store" });
				const payload = await response.json();
				if (!response.ok || payload.ok === false) throw new Error(payload.error || "读取失败");
				renderPost(payload.post);
			} catch (error) {
				readerEl.innerHTML = `<p class="live-error">文章读取失败：${escapeHtml(error.message)}</p>`;
			}
		}

		async function initLivePosts() {
			try {
				const response = await fetch("/api/kite-posts", { cache: "no-store" });
				const payload = await response.json();
				if (!response.ok || payload.ok === false) throw new Error(payload.error || "读取失败");
				posts = payload.posts || [];
				renderList();
				const initialSlug = location.hash.slice(1) || posts[0]?.slug;
				if (initialSlug) await loadPost(initialSlug);
			} catch (error) {
				if (countEl) countEl.textContent = "云端未连接";
				if (listEl) listEl.innerHTML = `<p class="live-error">云端文章不可用：${escapeHtml(error.message)}</p>`;
			}
		}

		listEl?.addEventListener("click", (event) => {
			const target = event.target instanceof HTMLElement ? event.target.closest("[data-slug]") : null;
			const slug = target?.getAttribute("data-slug");
			if (slug) loadPost(slug);
		});

		window.addEventListener("hashchange", () => loadPost(location.hash.slice(1)));
		initLivePosts();
	</script>
</MainGridLayout>

<style>
	.live-shell {
		display: grid;
		gap: 1rem;
	}

	.live-hero,
	.live-list-panel,
	.live-reader {
		border: 1px solid var(--line-divider);
		border-radius: var(--kite-card-radius, 14px);
		background: color-mix(in oklch, var(--card-bg) 78%, transparent);
		box-shadow: var(--surface-shadow);
		backdrop-filter: saturate(1.16) blur(var(--kite-glass-strength, 16px));
	}

	.live-hero {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: clamp(1.2rem, 3vw, 2rem);
	}

	.live-kicker {
		margin: 0 0 0.45rem;
		color: var(--primary);
		font-size: 0.78rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.live-hero h1,
	.live-list-panel h2,
	.live-reader h2 {
		margin: 0;
		color: rgb(23 23 23 / 0.9);
		letter-spacing: 0;
	}

	:global(.dark) .live-hero h1,
	:global(.dark) .live-list-panel h2,
	:global(.dark) .live-reader h2 {
		color: rgb(255 255 255 / 0.9);
	}

	.live-hero h1 {
		font-size: clamp(1.9rem, 4vw, 3.1rem);
		line-height: 1.05;
	}

	.live-hero p,
	.live-list-panel p,
	.live-reader p {
		margin: 0.5rem 0 0;
		color: var(--content-meta);
		line-height: 1.7;
	}

	.live-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		align-self: flex-start;
		min-height: 2.55rem;
		border: 1px solid color-mix(in oklch, var(--primary) 20%, var(--line-divider));
		border-radius: calc(var(--kite-card-radius, 14px) - 4px);
		padding: 0.65rem 0.85rem;
		color: var(--primary);
		background: color-mix(in oklch, var(--primary) 10%, transparent);
		font-weight: 800;
		text-decoration: none;
	}

	.live-layout {
		display: grid;
		grid-template-columns: minmax(18rem, 0.34fr) minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
	}

	.live-list-panel,
	.live-reader {
		padding: 1rem;
	}

	.live-list-panel {
		position: sticky;
		top: 5.25rem;
	}

	.panel-heading {
		display: flex;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.panel-heading > :global(svg) {
		color: var(--primary);
		font-size: 1.55rem;
		flex-shrink: 0;
	}

	.live-list {
		display: grid;
		gap: 0.65rem;
	}

	.live-list-item {
		display: grid;
		gap: 0.3rem;
		width: 100%;
		border: 1px solid var(--line-divider);
		border-radius: calc(var(--kite-card-radius, 14px) - 4px);
		padding: 0.85rem;
		color: inherit;
		background: color-mix(in oklch, var(--card-bg) 64%, transparent);
		text-align: left;
		cursor: pointer;
	}

	.live-list-item.active,
	.live-list-item:hover {
		border-color: color-mix(in oklch, var(--primary) 40%, var(--line-divider));
		background: color-mix(in oklch, var(--primary) 10%, var(--card-bg));
	}

	.live-list-item span,
	.live-list-item small,
	.reader-meta {
		color: var(--content-meta);
	}

	.live-reader {
		min-height: 28rem;
	}

	.empty-reader {
		display: grid;
		min-height: 24rem;
		place-items: center;
		align-content: center;
		text-align: center;
	}

	.empty-reader > :global(svg) {
		color: var(--primary);
		font-size: 3rem;
	}

	.reader-head {
		display: grid;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.reader-head img {
		width: 100%;
		aspect-ratio: 16 / 7;
		object-fit: cover;
		border-radius: calc(var(--kite-card-radius, 14px) - 2px);
	}

	.reader-head span {
		color: var(--primary);
		font-weight: 800;
	}

	.live-content {
		line-height: 1.82;
	}

	.live-content :where(h2, h3, h4) {
		margin: 1.4em 0 0.5em;
		letter-spacing: 0;
	}

	.live-content p {
		margin: 0.85em 0;
		color: inherit;
	}

	.live-content pre {
		overflow: auto;
		border-radius: calc(var(--kite-card-radius, 14px) - 4px);
		padding: 1rem;
		background: rgb(20 24 28 / 0.92);
		color: white;
	}

	.live-content code {
		border-radius: 0.35rem;
		padding: 0.08rem 0.28rem;
		background: color-mix(in oklch, var(--primary) 12%, transparent);
	}

	.live-content pre code {
		padding: 0;
		background: transparent;
	}

	.live-error {
		color: oklch(0.56 0.18 25);
		font-weight: 800;
	}

	@media (max-width: 960px) {
		.live-layout {
			grid-template-columns: 1fr;
		}

		.live-list-panel {
			position: static;
		}
	}

	@media (max-width: 640px) {
		.live-hero {
			flex-direction: column;
		}
	}
</style>
