---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "KiteBlog 后台";
const description = "KiteBlog 的网页端文章管理后台。";
---

<MainGridLayout title={title} description={description}>
	<section class="admin-shell">
		<div class="admin-hero">
			<div>
				<p class="admin-kicker">KiteBlog Admin</p>
				<h1>博客后台</h1>
				<p>输入后台密码后，可以直接在网页端管理文章、头像、背景和首页文案。</p>
			</div>
			<div class="admin-actions" data-admin-actions></div>
		</div>

		<div class="admin-panel" data-admin-panel>
			<form class="admin-login" data-login-form>
				<label>
					<span>后台密码</span>
					<input
						type="password"
						name="password"
						autocomplete="current-password"
						placeholder="输入 Cloudflare 环境变量 ADMIN_PASSWORD"
						required
					/>
				</label>
				<div class="admin-login-actions">
					<button type="submit" class="admin-button primary">
						<Icon is:inline name="material-symbols:lock-open-outline-rounded" />
						登录后台
					</button>
					<p data-login-state>正在检查登录状态...</p>
				</div>
			</form>
		</div>
	</section>

	<script is:inline>
		const panel = document.querySelector("[data-admin-panel]");
		const actions = document.querySelector("[data-admin-actions]");
		const form = document.querySelector("[data-login-form]");
		const loginState = document.querySelector("[data-login-state]");
		const params = new URLSearchParams(location.search);
		const error = params.get("error");

		function escapeHtml(value) {
			return String(value || "").replace(/[&<>"']/g, (char) => ({
				"&": "&amp;",
				"<": "&lt;",
				">": "&gt;",
				'"': "&quot;",
				"'": "&#39;",
			})[char]);
		}

		async function logout() {
			await fetch("/api/auth/logout", { method: "POST", cache: "no-store" });
			location.reload();
		}

		async function login(password) {
			const response = await fetch("/api/auth/login", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				cache: "no-store",
				body: JSON.stringify({ password }),
			});
			const payload = await response.json().catch(() => ({}));
			if (!response.ok || payload.ok === false) {
				throw new Error(payload.error || `登录失败：${response.status}`);
			}
			return payload;
		}

		function renderAuthenticated(user) {
			if (panel) {
				panel.innerHTML = `<div class="admin-user">
					<div>
						<strong>${escapeHtml(user?.name || "KiteBlog Admin")}</strong>
						<span>${escapeHtml(user?.login || "admin")}</span>
					</div>
				</div>`;
			}
			if (actions) {
				actions.innerHTML = `<a href="/admin/posts/" class="admin-button primary">管理文章</a>
					<a href="/admin/settings/" class="admin-button">站点设置</a>
					<button type="button" class="admin-button" data-logout>退出</button>`;
				document.querySelector("[data-logout]")?.addEventListener("click", logout);
			}
		}

		async function initAdmin() {
			if (error && panel) {
				if (loginState) loginState.textContent = error;
			}
			try {
				const response = await fetch("/api/admin/session", { cache: "no-store" });
				const payload = await response.json();
				if (payload.authenticated) {
					renderAuthenticated(payload.user);
				} else if (loginState && !error) {
					loginState.textContent = "请输入后台密码。";
				}
			} catch (error) {
				if (loginState) {
					loginState.textContent = error.message;
					loginState.classList.add("admin-error");
				}
			}
		}

		form?.addEventListener("submit", async (event) => {
			event.preventDefault();
			const password = new FormData(form).get("password");
			const button = form.querySelector("button[type='submit']");
			button.disabled = true;
			if (loginState) {
				loginState.textContent = "正在登录...";
				loginState.classList.remove("admin-error");
			}
			try {
				const payload = await login(password);
				renderAuthenticated(payload.user);
			} catch (error) {
				if (loginState) {
					loginState.textContent = error.message;
					loginState.classList.add("admin-error");
				}
			} finally {
				button.disabled = false;
			}
		});

		initAdmin();
	</script>
</MainGridLayout>

<style>
	.admin-shell {
		display: grid;
		gap: 1rem;
	}

	.admin-hero,
	.admin-panel {
		border: 1px solid var(--line-divider);
		border-radius: var(--kite-card-radius, 14px);
		background: color-mix(in oklch, var(--card-bg) 78%, transparent);
		box-shadow: var(--surface-shadow);
		backdrop-filter: saturate(1.16) blur(var(--kite-glass-strength, 16px));
	}

	.admin-hero {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: clamp(1.2rem, 3vw, 2rem);
	}

	.admin-kicker {
		margin: 0 0 0.45rem;
		color: var(--primary);
		font-size: 0.78rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.admin-hero h1 {
		margin: 0;
		font-size: clamp(1.9rem, 4vw, 3.1rem);
		line-height: 1.05;
		letter-spacing: 0;
	}

	.admin-hero p,
	.admin-panel p {
		margin: 0.5rem 0 0;
		color: var(--content-meta);
		line-height: 1.7;
	}

	.admin-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		align-items: flex-start;
	}

	.admin-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		min-height: 2.55rem;
		border: 1px solid color-mix(in oklch, var(--primary) 20%, var(--line-divider));
		border-radius: calc(var(--kite-card-radius, 14px) - 4px);
		padding: 0.65rem 0.85rem;
		color: var(--primary);
		background: color-mix(in oklch, var(--primary) 10%, transparent);
		font-weight: 800;
		text-decoration: none;
		cursor: pointer;
	}

	.admin-button.primary {
		color: white;
		background: linear-gradient(135deg, var(--primary), oklch(0.66 0.15 22));
	}

	.admin-panel {
		padding: 1rem;
	}

	.admin-login {
		display: grid;
		gap: 1rem;
		max-width: 34rem;
	}

	.admin-login label {
		display: grid;
		gap: 0.45rem;
	}

	.admin-login label span {
		color: var(--content-meta);
		font-size: 0.86rem;
		font-weight: 800;
	}

	.admin-login input {
		width: 100%;
		border: 1px solid var(--line-divider);
		border-radius: calc(var(--kite-card-radius, 14px) - 6px);
		padding: 0.75rem 0.85rem;
		color: var(--content);
		background: color-mix(in oklch, var(--card-bg) 70%, transparent);
		outline: none;
	}

	.admin-login input:focus {
		border-color: var(--primary);
	}

	.admin-login-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
	}

	.admin-button:disabled {
		opacity: 0.55;
		cursor: wait;
	}

	.admin-user {
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}

	.admin-user img {
		width: 3rem;
		height: 3rem;
		border-radius: 999px;
	}

	.admin-user span {
		display: block;
		color: var(--content-meta);
	}

	.admin-error {
		color: oklch(0.56 0.18 25);
		font-weight: 800;
	}

	@media (max-width: 640px) {
		.admin-hero {
			flex-direction: column;
		}
	}
</style>
