---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "站点设置";
const description = "管理 KiteBlog 的头像、背景和首页文案";
---

<MainGridLayout title={title} description={description}>
	<section class="admin-settings">
		<header class="admin-header">
			<div>
				<p class="eyebrow">KiteBlog Admin</p>
				<h1>站点设置</h1>
				<p data-session-state>正在检查登录状态...</p>
			</div>
			<nav class="header-actions" aria-label="后台导航">
				<a href="/admin/posts/" class="admin-button">
					<Icon is:inline name="material-symbols:article-outline-rounded" />
					文章
				</a>
				<a href="/admin/" class="admin-button">
					<Icon is:inline name="material-symbols:dashboard-outline-rounded" />
					后台
				</a>
			</nav>
		</header>

		<div class="settings-layout" data-settings-form hidden>
			<form class="settings-panel">
				<section class="form-section">
					<h2>基础信息</h2>
					<div class="field-grid">
						<label><span>博客名称</span><input data-field="siteTitle" maxlength="80" autocomplete="off" /></label>
						<label><span>博客副标题</span><input data-field="siteSubtitle" maxlength="180" autocomplete="off" /></label>
						<label><span>显示名称</span><input data-field="profileName" maxlength="80" autocomplete="off" /></label>
						<label><span>GitHub 链接</span><input data-field="githubUrl" placeholder="https://github.com/ciyuan1234" /></label>
						<label><span>QQ 链接</span><input data-field="qqUrl" placeholder="tencent://message/?uin=你的QQ号" /></label>
						<label><span>头像 URL</span><input data-field="avatarUrl" placeholder="https://example.com/avatar.jpg" /></label>
						<label class="wide"><span>个人简介</span><textarea data-field="profileBio" rows="3" maxlength="240"></textarea></label>
					</div>
				</section>

				<section class="form-section">
					<h2>首页与背景</h2>
					<div class="field-grid">
						<label><span>首页标题</span><input data-field="heroTitle" maxlength="100" /></label>
						<label>
							<span>壁纸模式</span>
							<select data-field="wallpaperMode">
								<option value="banner">横幅</option>
								<option value="fullscreen">全屏</option>
								<option value="overlay">透明覆盖</option>
								<option value="none">关闭</option>
							</select>
						</label>
						<label class="wide"><span>首页副标题</span><textarea data-field="heroSubtitles" rows="4" placeholder="每行一条"></textarea></label>
						<label class="wide"><span>统一背景 URL</span><textarea data-field="backgroundUrl" rows="4" placeholder="每行一个图片 URL 或本地路径"></textarea></label>
						<label><span>遮罩暗度</span><input data-field="dimOpacity" type="number" min="0" max="0.85" step="0.05" /></label>
						<label><span>播放器地址</span><input data-field="playerUrl" placeholder="https://example.com/video.mp4" /></label>
						<label class="check-row"><input data-field="carouselEnable" type="checkbox" /><span>启用背景轮播</span></label>
						<label class="check-row"><input data-field="playerEnable" type="checkbox" /><span>启用背景播放器</span></label>
					</div>
				</section>

				<footer class="settings-footer">
					<p data-save-state>保存后会提交到 GitHub，Cloudflare 部署完成后全站生效。</p>
					<button type="submit" class="admin-button primary">
						<Icon is:inline name="material-symbols:cloud-upload-outline-rounded" />
						保存到 GitHub
					</button>
				</footer>
			</form>

			<aside class="preview-panel">
				<h2>预览</h2>
				<div class="avatar-preview">
					<img data-avatar-preview alt="头像预览" />
					<div>
						<strong data-name-preview>Kite</strong>
						<p data-bio-preview>写技术、项目、生活和一些长期问题。</p>
					</div>
				</div>
				<div class="background-preview">
					<img data-background-preview alt="背景预览" />
					<span data-background-state>背景预览</span>
				</div>
				<p class="preview-note">这里是后台预览；访客页面会在 Cloudflare 部署后更新。</p>
			</aside>
		</div>

		<div class="settings-panel" data-empty-panel>
			<p>正在读取设置...</p>
		</div>
	</section>

	<script is:inline>
		const formWrap = document.querySelector("[data-settings-form]");
		const form = formWrap?.querySelector("form");
		const emptyPanel = document.querySelector("[data-empty-panel]");
		const stateEl = document.querySelector("[data-session-state]");
		const saveState = document.querySelector("[data-save-state]");
		const avatarPreview = document.querySelector("[data-avatar-preview]");
		const backgroundPreview = document.querySelector("[data-background-preview]");
		const backgroundState = document.querySelector("[data-background-state]");
		const namePreview = document.querySelector("[data-name-preview]");
		const bioPreview = document.querySelector("[data-bio-preview]");

		function field(name) {
			return document.querySelector(`[data-field="${name}"]`);
		}

		function setState(message, isError = false) {
			if (!saveState) return;
			saveState.textContent = message || "";
			saveState.classList.toggle("error", Boolean(isError));
		}

		async function apiRequest(url, options = {}) {
			const response = await fetch(url, { ...options, cache: "no-store" });
			const payload = await response.json().catch(() => ({}));
			if (!response.ok || payload.ok === false) {
				throw new Error(payload.error || `请求失败: ${response.status}`);
			}
			return payload;
		}

		function writeField(name, value) {
			const el = field(name);
			if (!el) return;
			if (el.type === "checkbox") {
				el.checked = Boolean(value);
				return;
			}
			el.value = Array.isArray(value) ? value.join("\n") : value || "";
		}

		function readField(name) {
			const el = field(name);
			if (!el) return "";
			if (el.type === "checkbox") return el.checked;
			if (["backgroundUrl", "heroSubtitles"].includes(name)) {
				return el.value.split(/\r?\n/).map((item) => item.trim()).filter(Boolean);
			}
			return el.value.trim();
		}

		function firstImage(value) {
			const list = Array.isArray(value) ? value : String(value || "").split(/\r?\n|,/);
			return list.map((item) => item.trim()).find(Boolean) || "";
		}

		function updatePreview() {
			const avatar = readField("avatarUrl");
			const bg = firstImage(readField("backgroundUrl"));
			if (avatarPreview) avatarPreview.src = avatar || "/favicon/firefly-32.png";
			if (backgroundPreview) backgroundPreview.src = bg || "";
			if (backgroundState) backgroundState.textContent = bg ? "背景预览" : "未设置背景";
			if (namePreview) namePreview.textContent = readField("profileName") || "Kite";
			if (bioPreview) bioPreview.textContent = readField("profileBio") || "写技术、项目、生活和一些长期问题。";
		}

		function fill(settings) {
			for (const key of [
				"siteTitle",
				"siteSubtitle",
				"profileName",
				"profileBio",
				"avatarUrl",
				"githubUrl",
				"qqUrl",
				"wallpaperMode",
				"backgroundUrl",
				"heroTitle",
				"heroSubtitles",
				"playerUrl",
				"playerEnable",
				"dimOpacity",
				"carouselEnable",
			]) writeField(key, settings[key]);
			updatePreview();
		}

		function collect() {
			return {
				siteTitle: readField("siteTitle"),
				siteSubtitle: readField("siteSubtitle"),
				profileName: readField("profileName"),
				profileBio: readField("profileBio"),
				avatarUrl: readField("avatarUrl"),
				githubUrl: readField("githubUrl"),
				qqUrl: readField("qqUrl"),
				wallpaperMode: readField("wallpaperMode"),
				backgroundUrl: readField("backgroundUrl"),
				heroTitle: readField("heroTitle"),
				heroSubtitles: readField("heroSubtitles"),
				playerUrl: readField("playerUrl"),
				playerEnable: readField("playerEnable"),
				dimOpacity: readField("dimOpacity"),
				carouselEnable: readField("carouselEnable"),
			};
		}

		async function initSettings() {
			try {
				const session = await apiRequest("/api/admin/session");
				if (!session.authenticated) {
					if (stateEl) stateEl.innerHTML = '<a href="/api/auth/github/start">使用 GitHub 登录</a>';
					if (emptyPanel) emptyPanel.innerHTML = "<p>需要先登录才能管理设置。</p>";
					return;
				}
				if (stateEl) stateEl.textContent = `已登录：@${session.user.login}`;
				const payload = await apiRequest("/api/admin/settings");
				fill(payload.settings || {});
				if (emptyPanel) emptyPanel.hidden = true;
				if (formWrap) formWrap.hidden = false;
			} catch (error) {
				if (emptyPanel) emptyPanel.innerHTML = `<p class="error">${error.message}</p>`;
			}
		}

		formWrap?.addEventListener("input", updatePreview);
		avatarPreview?.addEventListener("error", () => setState("头像无法加载，请检查 URL 是否可访问。", true));
		backgroundPreview?.addEventListener("error", () => {
			if (backgroundState) backgroundState.textContent = "背景图片无法加载";
		});
		form?.addEventListener("submit", async (event) => {
			event.preventDefault();
			const button = form.querySelector("button[type='submit']");
			button.disabled = true;
			setState("正在提交到 GitHub...");
			try {
				await apiRequest("/api/admin/settings", {
					method: "PUT",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(collect()),
				});
				setState("已提交到 GitHub，Cloudflare 部署后电脑和手机都会同步。", "success");
			} catch (error) {
				setState(error.message, true);
			} finally {
				button.disabled = false;
			}
		});

		initSettings();
	</script>
</MainGridLayout>

<style>
	.admin-settings { display: grid; gap: 1rem; }
	.admin-header, .settings-panel, .preview-panel {
		border: 1px solid var(--line-divider);
		border-radius: 12px;
		background: color-mix(in oklch, var(--card-bg) 82%, transparent);
		box-shadow: var(--surface-shadow);
		backdrop-filter: saturate(1.14) blur(var(--kite-glass-strength, 16px));
	}
	.admin-header { display: flex; justify-content: space-between; gap: 1rem; padding: clamp(1.2rem, 3vw, 2rem); }
	.eyebrow { margin: 0 0 .45rem; color: var(--primary); font-size: .78rem; font-weight: 800; text-transform: uppercase; }
	h1 { margin: 0; font-size: clamp(1.9rem, 4vw, 3rem); line-height: 1.05; letter-spacing: 0; }
	h2 { margin: 0 0 1rem; font-size: 1rem; letter-spacing: 0; }
	.admin-header p, .preview-note { margin: .5rem 0 0; color: var(--content-meta); line-height: 1.7; }
	.header-actions, .settings-footer { display: flex; flex-wrap: wrap; gap: .65rem; align-items: center; justify-content: space-between; }
	.admin-button {
		display: inline-flex; align-items: center; justify-content: center; gap: .4rem; min-height: 2.5rem;
		border: 1px solid color-mix(in oklch, var(--primary) 20%, var(--line-divider));
		border-radius: 8px; padding: .62rem .85rem; color: var(--primary);
		background: color-mix(in oklch, var(--primary) 10%, transparent); font-weight: 800; text-decoration: none; cursor: pointer;
	}
	.admin-button.primary { color: white; background: linear-gradient(135deg, var(--primary), oklch(0.66 0.15 22)); }
	.admin-button:disabled { opacity: .55; cursor: wait; }
	.settings-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem); gap: 1rem; align-items: start; }
	.settings-panel, .preview-panel { padding: clamp(1rem, 2vw, 1.35rem); }
	.form-section + .form-section { margin-top: 1.3rem; padding-top: 1.2rem; border-top: 1px solid var(--line-divider); }
	.field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
	label { display: grid; gap: .45rem; min-width: 0; }
	label span { color: var(--content-meta); font-size: .86rem; font-weight: 800; }
	.wide { grid-column: 1 / -1; }
	input, select, textarea {
		width: 100%; border: 1px solid var(--line-divider); border-radius: 8px; padding: .72rem .8rem;
		color: var(--content); background: color-mix(in oklch, var(--card-bg) 70%, transparent); outline: none;
	}
	textarea { resize: vertical; line-height: 1.55; }
	input:focus, select:focus, textarea:focus { border-color: var(--primary); }
	.check-row { display: flex; align-items: center; gap: .6rem; }
	.check-row input { width: 1rem; height: 1rem; }
	.settings-footer { margin-top: 1rem; }
	.error { color: oklch(0.56 0.18 25) !important; font-weight: 800; }
	.avatar-preview { display: flex; gap: .85rem; align-items: center; }
	.avatar-preview img { width: 4.5rem; height: 4.5rem; border-radius: 50%; object-fit: cover; border: 2px solid color-mix(in oklch, var(--primary) 30%, transparent); }
	.avatar-preview strong { display: block; font-size: 1.05rem; overflow-wrap: anywhere; }
	.avatar-preview p { margin: .25rem 0 0; color: var(--content-meta); line-height: 1.5; }
	.background-preview { position: relative; overflow: hidden; margin-top: 1rem; aspect-ratio: 16 / 9; border-radius: 10px; background: color-mix(in oklch, var(--primary) 10%, var(--card-bg)); }
	.background-preview img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.background-preview span { position: absolute; left: .75rem; bottom: .75rem; padding: .3rem .55rem; border-radius: 999px; color: white; background: rgb(0 0 0 / .45); font-size: .78rem; font-weight: 800; }
	@media (max-width: 900px) { .settings-layout { grid-template-columns: 1fr; } }
	@media (max-width: 720px) { .admin-header { flex-direction: column; } .field-grid { grid-template-columns: 1fr; } }
</style>
