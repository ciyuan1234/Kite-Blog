---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "文章管理";
const description = "KiteBlog 文章新增、编辑和删除。";
---

<MainGridLayout title={title} description={description}>
	<section class="posts-shell">
		<header class="posts-hero">
			<div>
				<p class="posts-kicker">Posts</p>
				<h1>文章管理</h1>
				<p data-session-state>正在检查登录状态...</p>
			</div>
			<div class="posts-actions">
				<a href="/admin/posts/edit/" class="posts-button primary">
					<Icon is:inline name="material-symbols:add-circle-outline-rounded" />
					新建文章
				</a>
				<a href="/admin/" class="posts-button">
					<Icon is:inline name="material-symbols:admin-panel-settings-outline-rounded" />
					后台
				</a>
				<a href="/admin/settings/" class="posts-button">
					<Icon is:inline name="material-symbols:tune-rounded" />
					设置
				</a>
			</div>
		</header>

		<div class="posts-panel">
			<div class="toolbar">
				<input data-search placeholder="搜索标题、分类或标签" />
				<button type="button" data-refresh>
					<Icon is:inline name="material-symbols:refresh-rounded" />
					刷新
				</button>
			</div>
			<div class="post-list" data-post-list>
				<p class="empty-state">正在读取文章...</p>
			</div>
		</div>
	</section>

	<script is:inline>
		const stateEl = document.querySelector("[data-session-state]");
		const listEl = document.querySelector("[data-post-list]");
		const searchEl = document.querySelector("[data-search]");
		let posts = [];

		function escapeHtml(value) {
			return String(value || "").replace(/[&<>"']/g, (char) => ({
				"&": "&amp;",
				"<": "&lt;",
				">": "&gt;",
				'"': "&quot;",
				"'": "&#39;",
			})[char]);
		}

		async function apiRequest(url, options = {}) {
			const response = await fetch(url, { ...options, cache: "no-store" });
			const payload = await response.json().catch(() => ({}));
			if (!response.ok || payload.ok === false) {
				throw new Error(payload.error || `请求失败：${response.status}`);
			}
			return payload;
		}

		function renderPosts() {
			const query = searchEl?.value?.trim?.().toLowerCase() || "";
			const filtered = posts.filter((post) => {
				if (!query) return true;
				return [post.title, post.slug, post.category, post.description, ...(post.tags || [])]
					.join(" ")
					.toLowerCase()
					.includes(query);
			});
			if (!listEl) return;
			if (!filtered.length) {
				listEl.innerHTML = '<p class="empty-state">没有找到文章。</p>';
				return;
			}
			listEl.innerHTML = filtered.map((post) => `<article class="post-item">
				<div>
					<strong>${escapeHtml(post.title || post.slug)}</strong>
					<p>${escapeHtml(post.description || "暂无摘要")}</p>
					<span>${escapeHtml(post.published || "未设置日期")} · ${escapeHtml(post.category || "随笔")} · ${escapeHtml((post.tags || []).join(", "))}</span>
				</div>
				<div class="item-actions">
					<a href="/posts/${escapeHtml(post.slug)}/" target="_blank" rel="noreferrer">查看</a>
					<a href="/admin/posts/edit/?slug=${encodeURIComponent(post.slug)}">编辑</a>
					<button type="button" data-delete="${escapeHtml(post.slug)}">删除</button>
				</div>
			</article>`).join("");
		}

		async function loadPosts() {
			try {
				const session = await apiRequest("/api/admin/session");
				if (!session.authenticated) {
					stateEl.textContent = "未登录。";
					listEl.innerHTML = '<a class="login-link" href="/admin/">返回后台登录</a>';
					return;
				}
				stateEl.textContent = `已登录：${session.user.name || session.user.login}`;
				const payload = await apiRequest("/api/admin/posts");
				posts = payload.posts || [];
				renderPosts();
			} catch (error) {
				if (listEl) listEl.innerHTML = `<p class="error-text">${escapeHtml(error.message)}</p>`;
			}
		}

		async function deletePost(slug) {
			if (!confirm(`确定删除 ${slug} 吗？`)) return;
			try {
				await apiRequest(`/api/admin/posts/${encodeURIComponent(slug)}`, { method: "DELETE" });
				posts = posts.filter((post) => post.slug !== slug);
				renderPosts();
			} catch (error) {
				alert(error.message);
			}
		}

		searchEl?.addEventListener("input", renderPosts);
		document.querySelector("[data-refresh]")?.addEventListener("click", loadPosts);
		listEl?.addEventListener("click", (event) => {
			const target = event.target instanceof HTMLElement ? event.target.closest("[data-delete]") : null;
			const slug = target?.getAttribute("data-delete");
			if (slug) deletePost(slug);
		});
		loadPosts();
	</script>
</MainGridLayout>

<style>
	.posts-shell {
		display: grid;
		gap: 1rem;
	}

	.posts-hero,
	.posts-panel,
	.post-item {
		border: 1px solid var(--line-divider);
		border-radius: var(--kite-card-radius, 14px);
		background: color-mix(in oklch, var(--card-bg) 78%, transparent);
		box-shadow: var(--surface-shadow);
		backdrop-filter: saturate(1.16) blur(var(--kite-glass-strength, 16px));
	}

	.posts-hero {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: clamp(1.2rem, 3vw, 2rem);
	}

	.posts-kicker {
		margin: 0 0 0.45rem;
		color: var(--primary);
		font-size: 0.78rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.posts-hero h1 {
		margin: 0;
		font-size: clamp(1.9rem, 4vw, 3.1rem);
		line-height: 1.05;
		letter-spacing: 0;
	}

	.posts-hero p,
	.post-item p {
		margin: 0.5rem 0 0;
		color: var(--content-meta);
		line-height: 1.7;
	}

	.posts-actions,
	.item-actions,
	.toolbar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.posts-button,
	.item-actions a,
	button,
	.login-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		min-height: 2.45rem;
		border: 1px solid color-mix(in oklch, var(--primary) 20%, var(--line-divider));
		border-radius: calc(var(--kite-card-radius, 14px) - 4px);
		padding: 0.6rem 0.8rem;
		color: var(--primary);
		background: color-mix(in oklch, var(--primary) 10%, transparent);
		font-weight: 800;
		text-decoration: none;
		cursor: pointer;
	}

	.posts-button.primary {
		color: white;
		background: linear-gradient(135deg, var(--primary), oklch(0.66 0.15 22));
	}

	.posts-panel {
		padding: 1rem;
	}

	.toolbar {
		margin-bottom: 1rem;
	}

	.toolbar input {
		flex: 1;
		min-width: 14rem;
		border: 1px solid var(--line-divider);
		border-radius: calc(var(--kite-card-radius, 14px) - 4px);
		padding: 0.75rem 0.85rem;
		color: inherit;
		background: color-mix(in oklch, var(--card-bg) 70%, transparent);
	}

	.post-list {
		display: grid;
		gap: 0.8rem;
	}

	.post-item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1rem;
		padding: 1rem;
	}

	.post-item strong {
		display: block;
		font-size: 1.1rem;
		overflow-wrap: anywhere;
	}

	.post-item span,
	.empty-state {
		color: var(--content-meta);
	}

	.error-text {
		color: oklch(0.56 0.18 25);
		font-weight: 800;
	}

	@media (max-width: 760px) {
		.posts-hero,
		.post-item {
			grid-template-columns: 1fr;
			flex-direction: column;
		}
	}
</style>
