---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "编辑文章";
const description = "KiteBlog 网页端 Markdown 文章编辑器。";
---

<MainGridLayout title={title} description={description}>
	<section class="edit-shell">
		<header class="edit-header">
			<div>
				<p class="eyebrow">Editor</p>
				<h1 data-page-title>新建文章</h1>
				<p data-session-state>正在检查登录状态...</p>
			</div>
			<div class="edit-actions">
				<a href="/admin/posts/" class="edit-button">
					<Icon is:inline name="material-symbols:arrow-back-rounded" />
					文章列表
				</a>
				<a href="/admin/categories/" class="edit-button">
					<Icon is:inline name="material-symbols:category-outline-rounded" />
					分类
				</a>
				<button type="button" data-save class="edit-button primary">
					<Icon is:inline name="material-symbols:cloud-upload-outline-rounded" />
					保存
				</button>
			</div>
		</header>

		<form id="post-form" class="edit-panel">
			<div class="field-grid">
				<label>
					<span>标题</span>
					<input name="title" value="新的博客文章" required autocomplete="off" />
				</label>
				<label>
					<span>Slug</span>
					<input name="slug" value="new-post" required autocomplete="off" />
				</label>
				<label>
					<span>发布日期</span>
					<input name="published" type="date" />
				</label>
				<label>
					<span>分类</span>
					<input name="category" value="随笔" list="category-options" autocomplete="off" />
					<datalist id="category-options"></datalist>
				</label>
				<label>
					<span>标签</span>
					<input name="tags" value="KiteBlog, 随笔" autocomplete="off" />
				</label>
				<label>
					<span>封面图 URL</span>
					<input name="image" placeholder="https://example.com/cover.jpg" />
				</label>
				<label class="span-2">
					<span>摘要</span>
					<input name="description" value="这里是文章摘要。" autocomplete="off" />
				</label>
				<label class="span-2">
					<span>Markdown 正文</span>
					<textarea name="body" rows="26" required>从这里开始写正文。</textarea>
				</label>
			</div>
			<div class="edit-footer">
				<p class="edit-status" data-status>等待操作。</p>
				<div class="edit-actions">
					<button type="button" data-save class="edit-button primary">保存</button>
					<button type="button" data-delete class="edit-button danger">删除</button>
				</div>
			</div>
		</form>
	</section>

	<script is:inline>
		const form = document.getElementById("post-form");
		const statusEl = document.querySelector("[data-status]");
		const sessionEl = document.querySelector("[data-session-state]");
		const titleEl = document.querySelector("[data-page-title]");
		const categoryOptions = document.getElementById("category-options");
		const params = new URLSearchParams(location.search);
		const editingSlug = params.get("slug") || "";

		function escapeHtml(value) {
			return String(value || "").replace(/[&<>"']/g, (char) => ({
				"&": "&amp;",
				"<": "&lt;",
				">": "&gt;",
				'"': "&quot;",
				"'": "&#39;",
			})[char]);
		}

		function setStatus(message, state = "info") {
			if (!statusEl) return;
			statusEl.textContent = message;
			statusEl.dataset.state = state;
		}

		async function apiRequest(url, options = {}) {
			const headers = new Headers(options.headers || {});
			if (options.body) headers.set("Content-Type", "application/json");
			const response = await fetch(url, { ...options, headers, cache: "no-store" });
			const payload = await response.json().catch(() => ({}));
			if (!response.ok || payload.ok === false) {
				throw new Error(payload.error || `请求失败：${response.status}`);
			}
			return payload;
		}

		function today() {
			return new Date().toISOString().slice(0, 10);
		}

		function readForm() {
			return {
				title: form.elements.title.value.trim(),
				slug: form.elements.slug.value.trim(),
				published: form.elements.published.value || today(),
				category: form.elements.category.value.trim(),
				tags: form.elements.tags.value.split(",").map((tag) => tag.trim()).filter(Boolean),
				description: form.elements.description.value.trim(),
				image: form.elements.image.value.trim(),
				body: form.elements.body.value.trim(),
			};
		}

		function fillForm(post) {
			form.elements.title.value = post.title || "";
			form.elements.slug.value = post.slug || editingSlug;
			form.elements.slug.readOnly = true;
			form.elements.published.value = post.published || today();
			form.elements.category.value = post.category || "";
			form.elements.tags.value = (post.tags || []).join(", ");
			form.elements.description.value = post.description || "";
			form.elements.image.value = post.image || "";
			form.elements.body.value = post.body || "";
			if (titleEl) titleEl.textContent = `编辑：${post.title || post.slug}`;
		}

		async function loadCategories() {
			const payload = await apiRequest("/api/admin/categories");
			if (!categoryOptions) return;
			categoryOptions.innerHTML = (payload.categories || [])
				.map((item) => `<option value="${escapeHtml(item.name)}">${escapeHtml(item.count)} 篇</option>`)
				.join("");
		}

		async function checkSession() {
			const payload = await apiRequest("/api/admin/session");
			if (!payload.authenticated) {
				if (sessionEl) sessionEl.innerHTML = '<a href="/api/auth/github/start">使用 GitHub 登录</a>';
				form.hidden = true;
				return false;
			}
			if (sessionEl) sessionEl.textContent = `已登录：@${payload.user.login}`;
			return true;
		}

		async function loadPost() {
			await loadCategories();
			if (!editingSlug) {
				form.elements.published.value = today();
				document.querySelector("[data-delete]").hidden = true;
				return;
			}
			setStatus("正在读取文章...", "info");
			const payload = await apiRequest(`/api/admin/posts/${encodeURIComponent(editingSlug)}`);
			fillForm(payload.post);
			setStatus("文章已载入。", "success");
		}

		async function savePost() {
			const post = readForm();
			if (!post.title || !post.slug || !post.body) {
				setStatus("标题、Slug 和正文不能为空。", "error");
				return;
			}
			document.querySelectorAll("[data-save]").forEach((button) => button.disabled = true);
			setStatus("正在保存到 GitHub...", "info");
			try {
				if (editingSlug) {
					await apiRequest(`/api/admin/posts/${encodeURIComponent(editingSlug)}`, {
						method: "PUT",
						body: JSON.stringify(post),
					});
				} else {
					await apiRequest("/api/admin/posts", {
						method: "POST",
						body: JSON.stringify(post),
					});
					history.replaceState(null, "", `/admin/posts/edit/?slug=${encodeURIComponent(post.slug)}`);
					form.elements.slug.readOnly = true;
				}
				await loadCategories();
				setStatus("已提交到 GitHub。Cloudflare 自动部署完成后，前台文章会更新。", "success");
			} catch (error) {
				setStatus(error.message, "error");
			} finally {
				document.querySelectorAll("[data-save]").forEach((button) => button.disabled = false);
			}
		}

		async function deletePost() {
			const slug = editingSlug || form.elements.slug.value.trim();
			if (!slug) return;
			if (!confirm(`确定删除 ${slug} 吗？删除后会提交到 GitHub。`)) return;
			setStatus("正在删除...", "info");
			try {
				await apiRequest(`/api/admin/posts/${encodeURIComponent(slug)}`, { method: "DELETE" });
				location.href = "/admin/posts/";
			} catch (error) {
				setStatus(error.message, "error");
			}
		}

		document.querySelectorAll("[data-save]").forEach((button) => button.addEventListener("click", savePost));
		document.querySelector("[data-delete]")?.addEventListener("click", deletePost);
		checkSession().then((ok) => {
			if (ok) loadPost().catch((error) => setStatus(escapeHtml(error.message), "error"));
		});
	</script>
</MainGridLayout>

<style>
	.edit-shell { display: grid; gap: 1rem; }
	.edit-header, .edit-panel {
		border: 1px solid var(--line-divider); border-radius: 12px;
		background: color-mix(in oklch, var(--card-bg) 82%, transparent);
		box-shadow: var(--surface-shadow); backdrop-filter: saturate(1.14) blur(var(--kite-glass-strength, 16px));
	}
	.edit-header { display: flex; justify-content: space-between; gap: 1rem; padding: clamp(1.2rem, 3vw, 2rem); }
	.eyebrow { margin: 0 0 .45rem; color: var(--primary); font-size: .78rem; font-weight: 800; text-transform: uppercase; }
	h1 { margin: 0; font-size: clamp(1.9rem, 4vw, 3.1rem); line-height: 1.05; letter-spacing: 0; }
	.edit-header p { margin: .5rem 0 0; color: var(--content-meta); line-height: 1.7; }
	.edit-actions { display: flex; flex-wrap: wrap; gap: .65rem; align-items: center; }
	.edit-button {
		display: inline-flex; align-items: center; justify-content: center; gap: .4rem; min-height: 2.45rem;
		border: 1px solid color-mix(in oklch, var(--primary) 20%, var(--line-divider)); border-radius: 8px;
		padding: .6rem .8rem; color: var(--primary); background: color-mix(in oklch, var(--primary) 10%, transparent);
		font-weight: 800; text-decoration: none; cursor: pointer;
	}
	.edit-button.primary { color: white; background: linear-gradient(135deg, var(--primary), oklch(0.66 0.15 22)); }
	.edit-button.danger { color: oklch(0.56 0.18 25); }
	.edit-button:disabled { opacity: .55; cursor: wait; }
	.edit-panel { padding: 1rem; }
	.field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 .85rem; }
	.span-2 { grid-column: 1 / -1; }
	label { display: grid; gap: .4rem; margin-bottom: .9rem; font-weight: 700; }
	label span { color: var(--content-meta); font-size: .84rem; }
	input, textarea {
		width: 100%; min-width: 0; border: 1px solid var(--line-divider); border-radius: 8px;
		padding: .75rem .85rem; color: inherit; background: color-mix(in oklch, var(--card-bg) 70%, transparent); outline: none;
	}
	input:focus, textarea:focus { border-color: var(--primary); }
	input[readonly] { opacity: .75; }
	textarea { resize: vertical; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; line-height: 1.6; }
	.edit-footer { display: flex; justify-content: space-between; gap: 1rem; align-items: center; flex-wrap: wrap; }
	.edit-status {
		flex: 1; min-width: 14rem; border: 1px solid var(--line-divider); border-radius: 8px; margin: 0;
		padding: .75rem; color: var(--content-meta); background: color-mix(in oklch, var(--card-bg) 64%, transparent); font-weight: 800;
	}
	.edit-status[data-state="success"] { color: oklch(0.55 0.14 155); }
	.edit-status[data-state="error"] { color: oklch(0.56 0.18 25); }
	@media (max-width: 760px) { .edit-header { flex-direction: column; } .field-grid { grid-template-columns: 1fr; } .span-2 { grid-column: auto; } .edit-actions, .edit-button { width: 100%; } }
</style>
