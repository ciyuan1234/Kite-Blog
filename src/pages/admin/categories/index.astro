---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "分类管理";
const description = "管理 KiteBlog 文章分类。";
---

<MainGridLayout title={title} description={description}>
	<section class="admin-list-shell">
		<header class="admin-list-header">
			<div>
				<p class="eyebrow">Categories</p>
				<h1>分类管理</h1>
				<p data-session-state>正在检查登录状态...</p>
			</div>
			<div class="actions">
				<a href="/admin/posts/" class="button">文章</a>
				<a href="/admin/" class="button">后台</a>
			</div>
		</header>

		<div class="panel">
			<div class="toolbar">
				<button type="button" class="button primary" data-refresh>
					<Icon is:inline name="material-symbols:refresh-rounded" />
					刷新
				</button>
				<p data-status>正在读取分类...</p>
			</div>
			<div class="list" data-list></div>
		</div>
	</section>

	<script is:inline>
		const stateEl = document.querySelector("[data-session-state]");
		const statusEl = document.querySelector("[data-status]");
		const listEl = document.querySelector("[data-list]");

		function escapeHtml(value) {
			return String(value || "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char]);
		}

		async function apiRequest(url, options = {}) {
			const headers = new Headers(options.headers || {});
			if (options.body) headers.set("Content-Type", "application/json");
			const response = await fetch(url, { ...options, headers, cache: "no-store" });
			const payload = await response.json().catch(() => ({}));
			if (!response.ok || payload.ok === false) throw new Error(payload.error || `请求失败：${response.status}`);
			return payload;
		}

		function setStatus(message, error = false) {
			statusEl.textContent = message;
			statusEl.classList.toggle("error", error);
		}

		function render(categories) {
			if (!categories.length) {
				listEl.innerHTML = '<p class="empty">还没有分类。编辑文章时填写分类后会自动出现。</p>';
				return;
			}
			listEl.innerHTML = categories.map((item) => `<article class="row">
				<div><strong>${escapeHtml(item.name)}</strong><span>${item.count} 篇文章</span></div>
				<div class="actions">
					<button type="button" data-rename="${escapeHtml(item.name)}">重命名</button>
					<button type="button" class="danger" data-delete="${escapeHtml(item.name)}">清空分类</button>
				</div>
			</article>`).join("");
		}

		async function load() {
			try {
				const session = await apiRequest("/api/admin/session");
				if (!session.authenticated) {
					stateEl.innerHTML = '<a href="/api/auth/github/start">使用 GitHub 登录</a>';
					listEl.innerHTML = "";
					setStatus("需要登录后管理分类。");
					return;
				}
				stateEl.textContent = `已登录：@${session.user.login}`;
				const payload = await apiRequest("/api/admin/categories");
				render(payload.categories || []);
				setStatus("分类已载入。");
			} catch (error) {
				setStatus(error.message, true);
			}
		}

		listEl.addEventListener("click", async (event) => {
			const rename = event.target.closest("[data-rename]")?.getAttribute("data-rename");
			const remove = event.target.closest("[data-delete]")?.getAttribute("data-delete");
			try {
				if (rename) {
					const next = prompt("新的分类名称", rename);
					if (!next || next === rename) return;
					setStatus("正在重命名分类...");
					await apiRequest(`/api/admin/categories/${encodeURIComponent(rename)}`, { method: "PUT", body: JSON.stringify({ name: next }) });
					await load();
				}
				if (remove) {
					if (!confirm(`确定把“${remove}”下的文章改为未分类吗？`)) return;
					setStatus("正在清空分类...");
					await apiRequest(`/api/admin/categories/${encodeURIComponent(remove)}`, { method: "DELETE" });
					await load();
				}
			} catch (error) {
				setStatus(error.message, true);
			}
		});
		document.querySelector("[data-refresh]")?.addEventListener("click", load);
		load();
	</script>
</MainGridLayout>

<style>
	.admin-list-shell { display: grid; gap: 1rem; }
	.admin-list-header, .panel, .row { border: 1px solid var(--line-divider); border-radius: 12px; background: color-mix(in oklch, var(--card-bg) 82%, transparent); box-shadow: var(--surface-shadow); }
	.admin-list-header { display: flex; justify-content: space-between; gap: 1rem; padding: clamp(1.2rem, 3vw, 2rem); }
	.eyebrow { margin: 0 0 .45rem; color: var(--primary); font-size: .78rem; font-weight: 800; text-transform: uppercase; }
	h1 { margin: 0; font-size: clamp(1.9rem, 4vw, 3rem); letter-spacing: 0; }
	.admin-list-header p, .toolbar p, .empty { margin: .5rem 0 0; color: var(--content-meta); }
	.panel { padding: 1rem; }
	.toolbar, .actions { display: flex; flex-wrap: wrap; gap: .65rem; align-items: center; }
	.toolbar { justify-content: space-between; margin-bottom: 1rem; }
	.list { display: grid; gap: .75rem; }
	.row { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem; }
	.row strong, .row span { display: block; }
	.row span { color: var(--content-meta); margin-top: .25rem; }
	.button, button { min-height: 2.4rem; border: 1px solid color-mix(in oklch, var(--primary) 20%, var(--line-divider)); border-radius: 8px; padding: .55rem .75rem; color: var(--primary); background: color-mix(in oklch, var(--primary) 10%, transparent); font-weight: 800; text-decoration: none; cursor: pointer; }
	.primary { color: white; background: linear-gradient(135deg, var(--primary), oklch(0.66 0.15 22)); }
	.danger, .error { color: oklch(0.56 0.18 25) !important; }
	@media (max-width: 680px) { .admin-list-header, .row { flex-direction: column; } }
</style>
